{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Brocks Scripts",
  "description": "Installation, configuration, integration, and support documentation for Brocks Scripts FiveM resources.",
  "colors": {
    "primary": "#8B5CF6",
    "light": "#A78BFA",
    "dark": "#7C3AED"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "dark": "#09090B",
      "light": "#FAFAFA"
    }
  },
  "icons": { "library": "lucide" },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "dark"
  },
  "navbar": {
    "links": [
      { "label": "Discord", "href": "https://example.com/discord", "icon": "message-circle" },
      { "label": "GitHub", "href": "https://github.com/", "icon": "github" }
    ],
    "primary": {
      "type": "button",
      "label": "Visit Store",
      "href": "https://example.com/tebex"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting Started",
        "icon": "rocket",
        "pages": [
          "index",
          "getting-started/introduction",
          "getting-started/getting-started",
          "getting-started/common-installation",
          "support/getting-support"
        ]
      },
      {
        "group": "Resources",
        "icon": "boxes",
        "pages": [
          {
            "group": "BL Warehouse",
            "icon": "warehouse",
            "pages": [
              "resources/bl-warehouse/overview",
              "resources/bl-warehouse/installation",
              "resources/bl-warehouse/configuration",
              "resources/bl-warehouse/items-and-rewards",
              "resources/bl-warehouse/framework-setup",
              "resources/bl-warehouse/full-config",
              "resources/bl-warehouse/troubleshooting"
            ]
          },
          "resources/future-resources"
        ]
      },
      {
        "group": "Developers",
        "icon": "code-2",
        "pages": [
          "developers/exports",
          "developers/events",
          "developers/integration-guide"
        ]
      },
      {
        "group": "Support",
        "icon": "life-buoy",
        "pages": [
          "support/common-issues",
          "support/getting-support",
          "support/faq"
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "discord": "https://example.com/discord",
      "github": "https://github.com/"
    },
    "links": [
      {
        "header": "Brocks Scripts",
        "items": [
          { "label": "Documentation", "href": "/" },
          { "label": "Tebex Store (placeholder)", "href": "https://example.com/tebex" },
          { "label": "Discord (placeholder)", "href": "https://example.com/discord" }
        ]
      }
    ]
  },
  "search": {
    "prompt": "Search Brocks Scripts documentation..."
  }
}
